{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secret — supplied at runtime, NOT committed.
  //   Local dev: set in appsettings.Development.json (gitignored) or user-secrets.
  //   Production (Fly.io): `fly secrets set GroqApiKey=...`
  "GroqApiKey": "",

  // Groq chat model used for the interviewer, grading, and output estimates.
  //   Groq retires models over time; list current ones with GET https://api.groq.com/openai/v1/models
  //   Override in production with `fly secrets set GroqModel=...` (empty = code default).
  "GroqModel": "openai/gpt-oss-20b",

  // Reasoning effort for "Run" (AI-estimated output). "low" is ~4x cheaper and faster than the
  //   default and was more accurate in testing; the free tier allows 8,000 tokens per minute,
  //   shared with the interviewer. Set to "" if GroqModel doesn't support reasoning_effort.
  "GroqRunReasoningEffort": "low",

  // Reasoning effort for the Practice AI check (Java, C#, C++, Go, Rust): the model traces
  //   the code on each test and predicts the return value; the server grades it. "medium" caught
  //   subtle bugs that "low" missed in testing.
  "GroqCheckReasoningEffort": "medium",

  // Reasoning effort for generating Practice problems (spec + tests + hidden reference
  //   solution). "medium" keeps expected answers accurate; the browser also re-checks them.
  "GroqProblemReasoningEffort": "medium",

  // Comma-separated list of allowed browser origins for CORS.
  //   Production: set the Netlify URL via `fly secrets set AllowedOrigins=https://your-site.netlify.app`
  // localhost:5173 is always allowed for local dev (see Program.cs).
  "AllowedOrigins": ""
}
